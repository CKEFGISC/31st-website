---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";

import BaseLayout from "~/layouts/BaseLayout.astro";
import Container from "~/components/Container.astro";
import TitleBar from "~/components/TitleBar.astro";
import SectionTitle from "~/components/SectionTitle.astro";
import SlidesPanel from "~/components/SlidesPanel.astro";
import Icon from "~/components/Icon.astro";
import type { Course } from "~/lib/courses";
import { asset } from "~/lib/images";

export const getStaticPaths: GetStaticPaths = async () => {
    const courses = await getCollection("courses");
    return courses.map((course) => ({
        params: { id: course.id },
        props: { course },
    }));
};

interface Props {
    course: Course;
}

const { course } = Astro.props;
const { title, shortTitle, image, instructors, slides } = course.data;
const { Content } = await render(course);
---

<BaseLayout title={shortTitle}>
    <TitleBar>課程介紹</TitleBar>

    <section id="individual-course">
        <Container>
            <div class="course">
                <Image
                    src={asset(image)}
                    alt={title}
                    width={1200}
                    widths={[400, 600, 800, 1200]}
                    sizes="(max-width: 992px) min(600px, 80vw), 400px"
                />
                <div class="description md">
                    <h1>{title}</h1>
                    {instructors.length > 0 && <p>講師：{instructors.join("、")}</p>}
                    <Content />
                </div>
            </div>

            <a href="/courses">
                <button class="btn btn-light mt-2">
                    <Icon name="arrow-left" size="1em" />
                    返回&nbsp;
                </button>
            </a>
        </Container>
    </section>

    {
        slides.length > 0 && (
            <section id="slides">
                <SectionTitle>簡報區</SectionTitle>
                <Container>
                    <SlidesPanel slides={slides} />
                </Container>
            </section>
        )
    }
</BaseLayout>

<style>
    .mt-2 {
        margin-top: 0.5rem;
    }
    button {
        display: inline-flex;
        align-items: center;
    }
</style>
