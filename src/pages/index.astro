---
import { Image } from "astro:assets";

import BaseLayout from "~/layouts/BaseLayout.astro";
import Container from "~/components/Container.astro";
import SectionTitle from "~/components/SectionTitle.astro";
import Card from "~/components/Card.astro";
import { site } from "~/data/site";
import hero from "~/assets/images/homepage/ckefgisc30.jpg";

const cards = [
    {
        href: "/about",
        image: "/images/homepage/about.webp",
        title: "關於我們",
        description: "關於建北電資",
    },
    {
        href: "/courses",
        image: "/images/homepage/class.jpg",
        title: "課程介紹",
        description: "社課介紹",
    },
    {
        href: "/events",
        image: "/images/homepage/event.jpg",
        title: "活動介紹",
        description: "四大獵祭與其他活動",
    },
    {
        href: "/museum",
        image: "/images/homepage/museum.jpg",
        title: "博物館",
        description: "歷屆的成果展示與網站",
    },
];
---

<BaseLayout>
    <section id="intro">
        <div class="jumbotron">
            <Image
                class="hero"
                src={hero}
                alt=""
                layout="full-width"
                loading="eager"
                fetchpriority="high"
            />
            <Container>
                <div class="row">
                    <div class="col-md-12">
                        <h1>{site.shortName}</h1>
                        <h2>
                            一個跨越 <span>{site.generation}</span> 年的大家庭
                        </h2>
                        <a href="/about" class="btn btn-outline-warning">
                            關於我們
                        </a>
                    </div>
                </div>
            </Container>
        </div>
    </section>

    <section id="map">
        <Container>
            <SectionTitle>網站地圖</SectionTitle>
            <div class="row">
                {cards.map((card) => <Card {...card} />)}
            </div>
        </Container>
    </section>
</BaseLayout>

<style>
    #intro > .jumbotron {
        /* fills what is left of the screen, so the header stays visible */
        position: relative;
        height: calc(100dvh - var(--header-h, 74px));
        display: flex;
        align-items: center;
        margin-bottom: 0;
        overflow: hidden;
        background-color: var(--color-ink);
    }

    /* the photo sits behind the text; brightness(0.5) is the black 50% wash
       the old background-image stacked on top of it */
    #intro .hero {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
        filter: brightness(0.5);
    }
    #intro > .jumbotron :global(.site-container) {
        position: relative;
    }

    #intro h1 {
        margin: 14px 0;
        color: var(--color-paper);
        font-size: 75px;
        font-weight: 600;
        text-shadow: 0 0 10px var(--color-ink);
        animation:
            firstSlide 1s,
            firstFade 1.25s;
    }

    #intro h2 {
        color: var(--color-paper);
        font-size: 22px;
        font-weight: 400;
        animation:
            mainSlide 1s,
            mainFade 1.5s;
    }

    #intro .btn {
        margin-top: 20px;
        padding: 10px 20px;
        border-width: 2px;
        border-radius: 30px;
        font-weight: 500;
        text-shadow: 0 0 3px var(--color-brand);
        animation:
            mainSlide 1.25s,
            mainFade 1.75s;
    }

    @media (max-width: 768px) {
        #intro h1 {
            font-size: 65px;
        }
        #intro h2 {
            font-size: 16px;
        }
    }
</style>
