---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container from "~/components/Container.astro";
import TitleBar from "~/components/TitleBar.astro";
import SectionTitle from "~/components/SectionTitle.astro";
import Icon from "~/components/Icon.astro";
import { museumSections } from "~/data/museum";
---

<BaseLayout title="博物館">
    <TitleBar>歷屆博物館</TitleBar>

    <section id="museum">
        {
            museumSections.map((section) => (
                <>
                    <SectionTitle>{section.heading}</SectionTitle>
                    <Container>
                        {section.entries.map((entry) => (
                            <div class="museum-item">
                                <img src={entry.image} alt="" loading="lazy" />
                                <div class="vertical-line" />
                                <div>
                                    <a
                                        href={entry.url}
                                        target="_blank"
                                        rel="noreferrer"
                                    >
                                        <h4>
                                            <span set:html={entry.title} />
                                            &nbsp;&nbsp;
                                            <Icon
                                                name="external"
                                                size="0.75em"
                                            />
                                        </h4>
                                    </a>
                                    {entry.body.map((paragraph) => (
                                        <p set:html={paragraph} />
                                    ))}
                                </div>
                            </div>
                        ))}
                    </Container>
                </>
            ))
        }
    </section>
</BaseLayout>

<style>
    #museum :global(.site-container) {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    h4 {
        display: flex;
        align-items: center;
    }
</style>
