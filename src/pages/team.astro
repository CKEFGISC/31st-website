---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container from "~/components/Container.astro";
import TitleBar from "~/components/TitleBar.astro";
import Person from "~/components/Person.astro";
import TeamSwitcher from "~/components/TeamSwitcher.tsx";
import { clubs } from "~/data/team";

const [ckeisc, fgisc] = clubs;
---

<BaseLayout title="幹部">
    <TitleBar>幹部介紹</TitleBar>

    <TeamSwitcher client:load labels={[ckeisc.label, fgisc.label]}>
        <Fragment slot="ckeisc">
            <Container class="flex flex-col items-center">
                {
                    ckeisc.members.map((person) => (
                            <Person person={person} />
                    ))
                }
            </Container>
        </Fragment>

        <Fragment slot="fgisc">
            <Container class="flex flex-col items-center">
                {fgisc.members.map((person) => <Person person={person} />)}
            </Container>
        </Fragment>
    </TeamSwitcher>
</BaseLayout>
