---
import { Image } from "astro:assets";

import chickenThick from "~/assets/images/chicken_thick.png";
import ckeiscMouse from "~/assets/images/ckeisc_mouse.png";
import fgiscStar from "~/assets/images/fgisc_star.png";
import x from "~/assets/images/x.png";
import { ordinal, site } from "~/data/site";
---

<a
    href="/"
    class="navbar-brand"
    aria-label={`${site.shortName} ${site.generation}${ordinal(site.generation)} 首頁`}
>
    <span class="icon">
        <span class="icon-text">
            <Image
                src={chickenThick}
                alt=""
                width={96}
                widths={[48, 96]}
                sizes="48px"
                class="mark on-rest"
            />
            <Image
                src={ckeiscMouse}
                alt=""
                width={96}
                widths={[48, 96]}
                sizes="48px"
                class="mark on-hover"
            />
            <span>&nbsp;CKE</span>
            <span class="on-hover wide"
                >ISC {site.ckeisc}<sup><small>{ordinal(site.ckeisc)}</small></sup></span
            >
            <Image
                src={x}
                alt=""
                width={96}
                widths={[48, 96]}
                sizes="48px"
                class="mark on-hover"
            />
            <span>FGISC&nbsp;</span>
            <span class="on-hover">{site.fgisc}<sup><small>{ordinal(site.fgisc)}</small></sup></span>
            <Image
                src={fgiscStar}
                alt=""
                width={96}
                widths={[48, 96]}
                sizes="48px"
                class="mark on-hover"
            />
            <span class="on-rest"
                >{site.generation}<sup><small>{ordinal(site.generation)}</small></sup>&nbsp;</span
            >
        </span>
    </span>
</a>

<style>
    /* Bootstrap .navbar-brand metrics */
    .navbar-brand {
        display: inline-block;
        color: #000;
        padding: 0.3125rem 0;
        margin-right: 1rem;
        font-size: 1.25rem;
        white-space: nowrap;
        cursor: pointer;
    }

    .icon {
        display: flex;
        width: fit-content;
        flex-direction: column;
        align-items: center;
        padding: 0.2em 0;
        font-family: var(--font-mono);
        font-size: 1.4rem;
        user-select: none;
    }

    .icon-text {
        display: flex;
        width: fit-content;
        align-items: flex-end;
    }

    .icon-text > * {
        display: inline-block;
        overflow-x: hidden;
        white-space: nowrap;
        transition: 500ms;
    }

    .icon-text img {
        height: auto;
    }

    /* collapsed by default, revealed on hover */
    .on-hover {
        width: 0;
        opacity: 0;
    }
    .on-rest {
        width: 2.25em;
        opacity: 1;
    }
    .mark.on-rest {
        width: 1.5em;
    }

    @media (min-width: 576px) {
        .icon:hover .on-rest {
            width: 0;
            opacity: 0;
        }
        .icon:hover .on-hover {
            width: 2.25em;
            opacity: 1;
        }
        .icon:hover .on-hover.wide {
            width: 4.45em;
        }
        .icon:hover .mark.on-hover {
            width: 1.5em;
        }

        /* ...but a shrunk header stays compact, so the bar does not jump */
        :global(.header-shrink) .icon:hover .on-rest {
            width: 2.25em;
            opacity: 1;
        }
        :global(.header-shrink) .icon:hover .mark.on-rest {
            width: 1.5em;
        }
        :global(.header-shrink) .icon:hover .on-hover {
            width: 0;
            opacity: 0;
        }
    }
</style>
