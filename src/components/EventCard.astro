---
import type { Event } from "~/data/events";

interface Props {
    event: Event;
}

const { event } = Astro.props;
---

<article class="mb-12 flex flex-col gap-6 md:flex-row md:gap-10" data-reveal>
    <div class="relative mx-auto w-fit shrink-0 md:mx-0">
        <img
            src={event.image ?? "/images/events/404.png"}
            alt=""
            loading="lazy"
            class="border-line w-80 max-w-[90dvw] rounded-2xl border-[3px]"
        />
        {
            event.imageCaption && (
                <p class="absolute bottom-4 left-8 rounded-full bg-white/95 px-3.5 py-1 text-base font-light">
                    {event.imageCaption}
                </p>
            )
        }
    </div>

    <div>
        <h3 class="text-[28px] font-normal">{event.title}</h3>
        <p class="text-sm">舉辦時間：{event.time}</p>
        <p class="mt-2 text-lg leading-relaxed">{event.description}</p>
    </div>
</article>
