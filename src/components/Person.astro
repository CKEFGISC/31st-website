---
import type { Person } from "~/data/team";

interface Props {
    person: Person;
}

const { person } = Astro.props;
---

<article
    class="mb-12 flex flex-col items-center gap-5 lg:flex-row lg:items-start"
    data-reveal
>
    <div
        class="relative size-[360px] max-h-[80dvw] max-w-[80dvw] shrink-0 lg:size-[250px] lg:max-h-none lg:max-w-none"
    >
        <img
            src={person.photo}
            alt={person.name}
            loading="lazy"
            class="size-full rounded-[20px] object-cover"
        />
        {
            person.photoAlt && (
                <img
                    src={person.photoAlt}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    class="absolute inset-0 size-full rounded-[20px] object-cover opacity-0 transition-opacity duration-200 hover:opacity-100"
                />
            )
        }
    </div>

    <div class="w-full lg:w-[42em] lg:max-w-[50vw]">
        <p class="mb-2 text-lg font-semibold">{person.role}&nbsp;─</p>
        <h2 class="mb-4 ml-8 text-3xl font-semibold">{person.name}</h2>

        <p class="mb-3 flex flex-wrap gap-x-2 gap-y-1">
            {
                person.tags.map((tag) => (
                    <span class="bg-paper-soft rounded-[3px] px-1 py-0.5">
                        #{tag}
                    </span>
                ))
            }
        </p>

        {
            person.description.map((paragraph) => (
                <p class="mb-1.5 leading-relaxed">{paragraph}</p>
            ))
        }
    </div>
</article>
