---
import { Image } from "astro:assets";

import { asset } from "~/lib/images";
import type { Person } from "~/data/team";

interface Props {
    person: Person;
}

const { person } = Astro.props;
---

<div class="person" data-reveal>
    <div class="person-photo">
        <Image
            src={asset(person.photo)}
            alt={person.name}
            width={500}
            widths={[250, 500]}
            sizes="250px"
            loading="lazy"
        />
        {
            person.photoAlt && (
                <Image
                    src={asset(person.photoAlt)}
                    alt=""
                    aria-hidden="true"
                    width={500}
                    widths={[250, 500]}
                    sizes="250px"
                    loading="lazy"
                    class="hover-to-show"
                />
            )
        }
    </div>

    <div class="description">
        <h4>{person.role}&nbsp;─&nbsp;</h4>
        <h2>{person.name}</h2>

        <p class="person-tags">
            {
                person.tags.map((tag, i) => (
                    <>
                        <span class="person-tag">#{tag}</span>
                        {i + 1 !== person.tags.length && <>,&nbsp;&nbsp;</>}
                    </>
                ))
            }
        </p>

        {
            person.description?.length ? (
                person.description.map((paragraph) => <p>{paragraph}</p>)
            ) : (
                <div class="coming-soon">
                    <span class="coming-soon-dots" aria-hidden="true">
                        <i />
                        <i />
                        <i />
                    </span>
                    <span class="coming-soon-text">敬請期待</span>
                    <span class="coming-soon-sub">介紹撰寫中，再等等我們</span>
                </div>
            )
        }
    </div>
</div>

<style>
    .person-photo {
        position: relative;
    }
    .person-photo img {
        width: 100%;
        height: 100%;
        border-radius: 20px;
        object-fit: cover;
    }
    h4 {
        margin-bottom: 0.5rem;
    }
    h2 {
        margin-bottom: 1rem;
        margin-left: 30px;
    }

    /* placeholder shown until a member's description is written */
    .coming-soon {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.35em;
        padding: 1.6em 1.2em;
        border: 2px dashed var(--color-line);
        border-radius: 14px;
        background:
            linear-gradient(
                115deg,
                transparent 30%,
                rgb(254 202 80 / 0.14) 50%,
                transparent 70%
            )
            no-repeat,
            var(--color-paper-soft);
        background-size:
            220% 100%,
            auto;
        animation: coming-soon-sheen 4s ease-in-out infinite;
    }

    .coming-soon-dots {
        display: flex;
        gap: 6px;
    }
    .coming-soon-dots i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--color-brand);
        animation: coming-soon-bounce 1.4s ease-in-out infinite;
    }
    .coming-soon-dots i:nth-child(2) {
        animation-delay: 0.18s;
        background: var(--color-brand-soft);
    }
    .coming-soon-dots i:nth-child(3) {
        animation-delay: 0.36s;
        background: var(--color-sand);
    }

    .coming-soon-text {
        font-family: var(--font-heading);
        font-size: 1.35rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        /* letter-spacing pads the right edge; pull it back so it stays centred */
        text-indent: 0.22em;
        color: var(--color-ink);
    }

    .coming-soon-sub {
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        color: color-mix(in srgb, var(--color-ink) 55%, transparent);
    }

    @keyframes coming-soon-sheen {
        0%,
        100% {
            background-position:
                140% 0,
                0 0;
        }
        55% {
            background-position:
                -40% 0,
                0 0;
        }
    }

    @keyframes coming-soon-bounce {
        0%,
        60%,
        100% {
            transform: translateY(0);
            opacity: 0.55;
        }
        30% {
            transform: translateY(-5px);
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .coming-soon,
        .coming-soon-dots i {
            animation: none;
        }
    }
</style>
