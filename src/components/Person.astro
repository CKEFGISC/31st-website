---
import { Image } from "astro:assets";

import { asset } from "~/lib/images";
import type { Person } from "~/data/team";

interface Props {
    person: Person;
}

const { person } = Astro.props;
---

<div class="person" data-reveal>
    <div class="person-photo">
        <Image
            src={asset(person.photo)}
            alt={person.name}
            width={500}
            widths={[250, 500]}
            sizes="250px"
            loading="lazy"
        />
        {
            person.photoAlt && (
                <Image
                    src={asset(person.photoAlt)}
                    alt=""
                    aria-hidden="true"
                    width={500}
                    widths={[250, 500]}
                    sizes="250px"
                    loading="lazy"
                    class="hover-to-show"
                />
            )
        }
    </div>

    <div class="description">
        <h4>{person.role}&nbsp;─&nbsp;</h4>
        <h2>{person.name}</h2>

        <p class="person-tags">
            {
                person.tags.map((tag, i) => (
                    <>
                        <span class="person-tag">#{tag}</span>
                        {i + 1 !== person.tags.length && <>,&nbsp;&nbsp;</>}
                    </>
                ))
            }
        </p>

        {
            person.description?.length ? (
                person.description.map((paragraph) => <p>{paragraph}</p>)
            ) : (
                <div class="coming-soon">
                    <span class="coming-soon-text">敬請期待</span>
                    <span class="coming-soon-sub">介紹撰寫中，再等等我們</span>
                </div>
            )
        }
    </div>
</div>

<style>
    .person-photo {
        position: relative;
    }
    .person-photo img {
        width: 100%;
        height: 100%;
        border-radius: 20px;
        object-fit: cover;
    }
    h4 {
        margin-bottom: 0.5rem;
    }
    h2 {
        margin-bottom: 1rem;
        margin-left: 30px;
    }

    /* placeholder shown until a member's description is written */
    .coming-soon {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.35em;
        padding: 1.6em 1.2em;
        border: 2px dashed var(--color-line);
        border-radius: 14px;
        background: var(--color-paper-soft);
    }

    .coming-soon-text {
        font-family: var(--font-heading);
        font-size: 1.35rem;
        font-weight: 500;
        letter-spacing: 0.22em;
        /* letter-spacing pads the right edge; pull it back so it stays centred */
        text-indent: 0.22em;
        color: var(--color-ink);
    }

    .coming-soon-sub {
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        color: color-mix(in srgb, var(--color-ink) 55%, transparent);
    }
</style>
