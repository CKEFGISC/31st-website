---
import { embedUrl, type Course } from "~/lib/courses";

interface Props {
    slides: Course["data"]["slides"];
}

const { slides } = Astro.props;
---

<div
    class="border-line flex h-[33em] overflow-hidden rounded-lg border-[3px] max-sm:h-auto max-sm:flex-col max-sm:border-none"
>
    <nav
        aria-label="簡報列表"
        class="thin-scrollbar my-[1.6em] ml-[0.6em] w-[24em] shrink-0 overflow-y-auto px-4 max-sm:hidden"
    >
        <ul class="flex flex-col">
            {
                slides.map((slide, i) => (
                    <li>
                        <a
                            href={`#slide-${i}`}
                            data-slide-link={i}
                            class="mb-1.5 block rounded-lg p-2 transition-colors duration-200 aria-[current=true]:bg-sand"
                        >
                            {slide.title}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>

    <div
        class="border-line my-[1.6em] hidden rounded border-2 sm:block"
        aria-hidden="true"
    >
    </div>

    <div
        id="slides-contents"
        class="thin-scrollbar my-[1.6em] mr-[0.6em] flex-1 overflow-y-auto px-4 max-sm:m-1 max-sm:overflow-visible max-sm:px-0"
    >
        {
            slides.map((slide, i) => (
                <section id={`slide-${i}`} data-slide={i}>
                    <h3 class="my-4 text-lg font-semibold first:mt-0">
                        {slide.title}
                    </h3>
                    <iframe
                        src={embedUrl(slide)}
                        title={slide.title}
                        loading="lazy"
                        width="560"
                        height="410"
                        allow="fullscreen"
                        allowfullscreen
                        class="max-h-[50dvw] max-w-[98%] rounded-md"
                    />
                </section>
            ))
        }
    </div>
</div>

<script>
    // highlight the deck currently scrolled into view
    const pane = document.getElementById("slides-contents");
    const links = document.querySelectorAll<HTMLAnchorElement>(
        "[data-slide-link]",
    );

    if (pane && links.length > 0) {
        const setActive = (index: number) => {
            for (const link of links) {
                link.setAttribute(
                    "aria-current",
                    String(link.dataset.slideLink === String(index)),
                );
            }
        };

        setActive(0);

        const observer = new IntersectionObserver(
            (entries) => {
                const visible = entries
                    .filter((entry) => entry.isIntersecting)
                    .sort(
                        (a, b) =>
                            a.boundingClientRect.top - b.boundingClientRect.top,
                    )[0];
                if (visible instanceof IntersectionObserverEntry) {
                    setActive(
                        Number(
                            (visible.target as HTMLElement).dataset.slide ?? 0,
                        ),
                    );
                }
            },
            { root: pane, threshold: 0.1 },
        );

        for (const section of pane.querySelectorAll("[data-slide]")) {
            observer.observe(section);
        }
    }
</script>
